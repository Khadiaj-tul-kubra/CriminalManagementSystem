@model CriminalManagementSystem.Models.Criminal

<h2>Add Criminal</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Age</label>
        <input asp-for="Age" class="form-control" />
    </div>

    <div class="mb-3">
        <label>CNIC</label>
        <input asp-for="CNIC" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Crime History</label>
        <textarea asp-for="CrimeHistory"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Status</label>
        <input asp-for="Status" class="form-control" />
    </div>

    <button class="btn btn-primary">
        Save Criminal
    </button>

</form>